# CatSight backend configuration — TEMPLATE
#
# Copy to backend/.env and fill in the placeholders. backend/.env is git-ignored.
# Run `git status` before every commit to confirm .env never appears.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ EVERY <PLACEHOLDER> below is waiting on GCP access details.             │
# │ This file is the ONLY place they need to change. Nothing else in the    │
# │ codebase may hardcode a project ID, bucket name or URL.                 │
# └─────────────────────────────────────────────────────────────────────────┘

# ── GCP project ──────────────────────────────────────────────────────────────
# The onboarding guide documents the team project as `techno-crackers-catsight`
# (owned by the project owner). Confirm whether deploys from this repo target
# that project or a new one, then replace the placeholder.
GOOGLE_CLOUD_PROJECT=<GCP_PROJECT_ID>

# Required. Gemini 3.x is NOT served from us-central1 — this must stay `global`.
# Cloud Run, Firestore and GCS remain in us-central1.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true

FIRESTORE_DATABASE=(default)

# Documented as `<project-id>-docs`. Confirm the exact name — the guide's
# access check 6 warns that it may differ.
GCS_BUCKET=<GCP_PROJECT_ID>-docs

# ── Models (C-2) ─────────────────────────────────────────────────────────────
# NEVER use gemini-2.5-* — retires 2026-10-20.
# These are the values from the spec. Verify they resolve on the project before
# tuning any prompt (the guide's access check 10 does exactly this).
MODEL_MAIN=gemini-3.5-flash-lite
MODEL_REASON=gemini-3.8-flash
MODEL_FALLBACK=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Optional, for cheaper local runs. Leave UNSET unless you mean it.
# Never achieve cheap dev runs by redefining MODEL_MAIN — prompts and
# structured outputs tuned on a model production never uses will drift.
# MODEL_DEV=gemini-3.1-flash-lite

# ── Secrets ──────────────────────────────────────────────────────────────────
# Production reads ADMIN_TOKEN from Secret Manager. Locally, any throwaway
# string is fine. NEVER commit a real token.
ADMIN_TOKEN=local-dev-only

# ── CORS (C-10) ──────────────────────────────────────────────────────────────
# The browser calls Cloud Run directly, so the Hosting origins must be listed.
# Add the real Hosting URL once the project ID is known, then redeploy.
ALLOWED_ORIGINS=http://localhost:5173,https://<GCP_PROJECT_ID>.web.app,https://<GCP_PROJECT_ID>.firebaseapp.com

# ── Cost and rate guards (C-12) ──────────────────────────────────────────────
DAILY_ANALYSIS_CAP=300
RATE_LIMIT_PER_HOUR=20

# ── Feature switches (REQUIREMENTS_V2 §7) ────────────────────────────────────
# Kill switch for the Clause Courtroom — disable without a redeploy if it
# misbehaves during judging.
COURTROOM_ENABLED=true
VERIFIER_MAX_RETRIES=1

# Force ALL traffic to cached replays. The lever to pull if quota is at risk
# mid-judging: zero LLM cost, demo still completes.
CACHED_REPLAY_ONLY=false
REPLAY_FIXTURE_DIR=data/replays
FIRST_EVENT_TIMEOUT_MS=4000

# ── FX assumptions (documented in data/ASSUMPTIONS.md) ───────────────────────
JPY_PER_USD=150
PHP_PER_USD=56
TWD_PER_USD=32
